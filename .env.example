# ── DevBox Cloud — Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Database (MySQL) ─────────────────────────────────────────────────────────
# Used by the Node/tRPC server (Drizzle ORM + mysql2).
# docker compose up mysql -d starts MySQL on localhost:3306.
DATABASE_URL=mysql://devbox:devbox123@localhost:3306/devbox

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# ── Auth ─────────────────────────────────────────────────────────────────────
# Secret used to sign JWT session tokens.
JWT_SECRET=change-this-in-production

# Hosted OAuth (optional — omit to use local dev login).
# VITE_APP_ID=
# OAUTH_SERVER_URL=
# VITE_OAUTH_PORTAL_URL=

# The openId of the user that should automatically receive the admin role.
# OWNER_OPEN_ID=

# Local development login name (shown in the UI).
CNAD32_LOCAL_AUTH_NAME=Local Operator

# ── Kubernetes ───────────────────────────────────────────────────────────────
# Path to a kubeconfig file (defaults to ~/.kube/config via loadFromDefault).
# KUBECONFIG=/path/to/kubeconfig

# Base64-encoded kubeconfig (alternative to KUBECONFIG path).
# CNAD32_KUBECONFIG_B64=

# Optional: host suffix for workspace Ingress (e.g. workspaces.example.com).
# When set, workspaces get an Ingress rule: <namespace>.<suffix>
# CNAD32_WORKSPACE_HOST_SUFFIX=

# Optional: Ingress class name (e.g. nginx).
# CNAD32_INGRESS_CLASS_NAME=

# ── Workspace Image ──────────────────────────────────────────────────────────
# All six templates use devbox/workspace:latest.
# Build: docker build -t devbox/workspace:latest ./workspace-image/
# Load:  minikube image load devbox/workspace:latest
