# ─── DevBox Environment Variables ─────────────────────────────────────────────
# Copy this to .env and fill in your values. Never commit .env to version control.

# ── Backend / Database ──────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/devboxdb
DB_USERNAME=devbox
DB_PASSWORD=devbox123

# ── Kubernetes ──────────────────────────────────────────────────────────────
# Namespace where DevBox will deploy user applications
K8S_NAMESPACE=devbox

# Set to true when running against Minikube (uses minikube image build strategy)
MINIKUBE_ENABLED=true

# ── Frontend ────────────────────────────────────────────────────────────────
# URL of the running backend (used by Vite proxy / fetch calls)
VITE_API_BASE_URL=http://localhost:8080
